    "Please take a moment to share feedback. It helps improving your experience." : {
      "comment" : "Please take a moment to share feedback. It helps improving your experience.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى تخصيص بعض الوقت لمشاركة التعليقات. يساعد على تحسين تجربتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug venligst et øjeblik på at dele feedback. Det hjælper med at forbedre din oplevelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte nehmen Sie sich einen Moment Zeit, um uns Feedback zu geben. Es trägt dazu bei, Ihre Erfahrung zu verbessern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφιερώστε λίγο χρόνο για να μοιραστείτε τα σχόλιά σας. Βοηθά στη βελτίωση της εμπειρίας σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please take a moment to share feedback. It helps improving your experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómese un momento para compartir sus comentarios. Ayuda a mejorar tu experiencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä hetki palautteen jakamiseen. Se auttaa parantamaan kokemustasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez prendre un moment pour partager vos commentaires. Cela aide à améliorer votre expérience."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנא הקדש רגע כדי לשתף משוב. זה עוזר לשפר את החוויה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कृपया प्रतिक्रिया साझा करने के लिए कुछ समय निकालें। यह आपके अनुभव को बेहतर बनाने में मदद करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérjük, szánjon egy percet a visszajelzés megosztására. Segít az élmény javításában."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mohon luangkan waktu sejenak untuk berbagi masukan. Ini membantu meningkatkan pengalaman Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per favore, prenditi un momento per condividere il tuo feedback. Aiuta a migliorare la tua esperienza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぜひフィードバックを共有してください。エクスペリエンスを向上させるのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠시 시간을 내어 피드백을 공유해주세요. 이는 귀하의 경험을 향상시키는 데 도움이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve um momento para compartilhar comentários. Isso ajuda a melhorar sua experiência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, найдите минутку, чтобы поделиться отзывом. Это помогает улучшить ваш опыт."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen geri bildiriminizi paylaşmak için bir dakikanızı ayırın. Deneyiminizi geliştirmenize yardımcı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь ласка, знайдіть хвилинку, щоб надіслати відгук. Це допомагає покращити ваш досвід."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng dành chút thời gian để chia sẻ phản hồi. Nó giúp cải thiện trải nghiệm của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请花一点时间分享反馈。它有助于改善您的体验。"
          }
        }
      }
    },
