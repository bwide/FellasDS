    "Are you enjoying the app so far?" : {
      "comment" : "Are you enjoying the app so far?",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تستمتع بالتطبيق حتى الآن؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyder du appen indtil videre?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat Ihnen die App bisher gefallen?"
          }
        },
