{
  "sourceLanguage": "en",
  "strings": {
    "Are you enjoying the app so far?": {
      "comment": "Are you enjoying the app so far?",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0644 \u062a\u0633\u062a\u0645\u062a\u0639 \u0628\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646\u061f"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyder du appen indtil videre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat Ihnen die App bisher gefallen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0391\u03c0\u03bf\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03bc\u03ad\u03c7\u03c1\u03b9 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae\u03c2;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you enjoying the app so far?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfEst\u00e1s disfrutando la aplicaci\u00f3n hasta ahora?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nautitko sovelluksesta toistaiseksi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appr\u00e9ciez-vous l\u2019application jusqu\u2019\u00e0 pr\u00e9sent\u00a0?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d0\u05dd \u05d0\u05ea\u05d4 \u05e0\u05d4\u05e0\u05d4 \u05de\u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e2\u05d3 \u05db\u05d4?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0905\u092c \u0924\u0915 \u0910\u092a \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eddig tetszik az alkalmaz\u00e1s?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda menikmati aplikasinya sejauh ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti \u00e8 piaciuta l'app finora?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u308c\u307e\u3067\u306e\u3068\u3053\u308d\u3001\u30a2\u30d7\u30ea\u3092\u697d\u3057\u3093\u3067\u3044\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uae08\uae4c\uc9c0 \uc571\uc744 \uc990\uaca8 \uc0ac\uc6a9\ud558\uace0 \uacc4\uc2dc\ub098\uc694?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 gostando do aplicativo at\u00e9 agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0430\u043c \u043f\u043e\u043a\u0430 \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eu ana kadar uygulamadan memnun musunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0438 \u043f\u043e\u0434\u043e\u0431\u0430\u0454\u0442\u044c\u0441\u044f \u0432\u0430\u043c \u0434\u043e\u0434\u0430\u0442\u043e\u043a?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho \u0111\u1ebfn nay b\u1ea1n c\u00f3 th\u00edch \u1ee9ng d\u1ee5ng n\u00e0y kh\u00f4ng?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5230\u76ee\u524d\u4e3a\u6b62\uff0c\u60a8\u559c\u6b22\u8fd9\u4e2a\u5e94\u7528\u7a0b\u5e8f\u5417\uff1f"
          }
        }
      }
    },
