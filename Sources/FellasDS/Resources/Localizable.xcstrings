    "Please take a moment to share feedback. It helps improving your experience.": {
      "comment": "Please take a moment to share feedback. It helps improving your experience.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0631\u062c\u0649 \u062a\u062e\u0635\u064a\u0635 \u0628\u0639\u0636 \u0627\u0644\u0648\u0642\u062a \u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a. \u064a\u0633\u0627\u0639\u062f \u0639\u0644\u0649 \u062a\u062d\u0633\u064a\u0646 \u062a\u062c\u0631\u0628\u062a\u0643."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug venligst et \u00f8jeblik p\u00e5 at dele feedback. Det hj\u00e6lper med at forbedre din oplevelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte nehmen Sie sich einen Moment Zeit, um uns Feedback zu geben. Es tr\u00e4gt dazu bei, Ihre Erfahrung zu verbessern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0391\u03c6\u03b9\u03b5\u03c1\u03ce\u03c3\u03c4\u03b5 \u03bb\u03af\u03b3\u03bf \u03c7\u03c1\u03cc\u03bd\u03bf \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03bc\u03bf\u03b9\u03c1\u03b1\u03c3\u03c4\u03b5\u03af\u03c4\u03b5 \u03c4\u03b1 \u03c3\u03c7\u03cc\u03bb\u03b9\u03ac \u03c3\u03b1\u03c2. \u0392\u03bf\u03b7\u03b8\u03ac \u03c3\u03c4\u03b7 \u03b2\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1\u03c2 \u03c3\u03b1\u03c2."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please take a moment to share feedback. It helps improving your experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3mese un momento para compartir sus comentarios. Ayuda a mejorar tu experiencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e4yt\u00e4 hetki palautteen jakamiseen. Se auttaa parantamaan kokemustasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez prendre un moment pour partager vos commentaires. Cela aide \u00e0 am\u00e9liorer votre exp\u00e9rience."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e0\u05d0 \u05d4\u05e7\u05d3\u05e9 \u05e8\u05d2\u05e2 \u05db\u05d3\u05d9 \u05dc\u05e9\u05ea\u05e3 \u05de\u05e9\u05d5\u05d1. \u05d6\u05d4 \u05e2\u05d5\u05d6\u05e8 \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4\u05d7\u05d5\u05d5\u05d9\u05d4 \u05e9\u05dc\u05da."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0938\u092e\u092f \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e9rj\u00fck, sz\u00e1njon egy percet a visszajelz\u00e9s megoszt\u00e1s\u00e1ra. Seg\u00edt az \u00e9lm\u00e9ny jav\u00edt\u00e1s\u00e1ban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohon luangkan waktu sejenak untuk berbagi masukan. Ini membantu meningkatkan pengalaman Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, prenditi un momento per condividere il tuo feedback. Aiuta a migliorare la tua esperienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305c\u3072\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u5171\u6709\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a8\u30af\u30b9\u30da\u30ea\u30a8\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\uc2dc \uc2dc\uac04\uc744 \ub0b4\uc5b4 \ud53c\ub4dc\ubc31\uc744 \uacf5\uc720\ud574\uc8fc\uc138\uc694. \uc774\ub294 \uadc0\ud558\uc758 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve um momento para compartilhar coment\u00e1rios. Isso ajuda a melhorar sua experi\u00eancia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043d\u0430\u0439\u0434\u0438\u0442\u0435 \u043c\u0438\u043d\u0443\u0442\u043a\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u043e\u0442\u0437\u044b\u0432\u043e\u043c. \u042d\u0442\u043e \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0432\u0430\u0448 \u043e\u043f\u044b\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00fctfen geri bildiriminizi payla\u015fmak i\u00e7in bir dakikan\u0131z\u0131 ay\u0131r\u0131n. Deneyiminizi geli\u015ftirmenize yard\u0131mc\u0131 olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0437\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0445\u0432\u0438\u043b\u0438\u043d\u043a\u0443, \u0449\u043e\u0431 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0432\u0456\u0434\u0433\u0443\u043a. \u0426\u0435 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0432\u0430\u0448 \u0434\u043e\u0441\u0432\u0456\u0434."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui l\u00f2ng d\u00e0nh ch\u00fat th\u1eddi gian \u0111\u1ec3 chia s\u1ebb ph\u1ea3n h\u1ed3i. N\u00f3 gi\u00fap c\u1ea3i thi\u1ec7n tr\u1ea3i nghi\u1ec7m c\u1ee7a b\u1ea1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u82b1\u4e00\u70b9\u65f6\u95f4\u5206\u4eab\u53cd\u9988\u3002\u5b83\u6709\u52a9\u4e8e\u6539\u5584\u60a8\u7684\u4f53\u9a8c\u3002"
          }
        }
      }
    },
