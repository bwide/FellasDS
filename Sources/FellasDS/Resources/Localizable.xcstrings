    "free.trial.toggle": {
      "comment": "Enable 3-Day Free Trial",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a \u0627\u0644\u0645\u062c\u0627\u0646\u064a \u0644\u0645\u062f\u0629 3 \u0623\u064a\u0627\u0645"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver 3-dages gratis pr\u00f8veperiode"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3-t\u00e4gige kostenlose Testversion aktivieren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03c4\u03b7 \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03b4\u03bf\u03ba\u03b9\u03bc\u03ae 3 \u03b7\u03bc\u03b5\u03c1\u03ce\u03bd"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable 3-Day Free Trial"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar prueba gratuita de 3 d\u00edas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota k\u00e4ytt\u00f6\u00f6n 3 p\u00e4iv\u00e4n ilmainen kokeilu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l'essai gratuit de 3 jours"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e4\u05e9\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d7\u05d9\u05e0\u05dd \u05dc-3 \u05d9\u05de\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3-\u0926\u093f\u0928 \u0915\u093e \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Enged\u00e9lyezze a 3 napos ingyenes pr\u00f3baverzi\u00f3t"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Uji Coba Gratis 3 Hari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita la prova gratuita di 3 giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3\u65e5\u9593\u306e\u7121\u6599\u30c8\u30e9\u30a4\u30a2\u30eb\u3092\u6709\u52b9\u306b\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3\uc77c \ubb34\ub8cc \uccb4\ud5d8\ud310 \ud65c\uc131\ud654"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar teste gratuito de 3 dias"
          }
        },
        "ru": {
